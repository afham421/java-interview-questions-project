🧱 1. Order Service (Publisher of OrderCreatedEvent)
java
Copy
Edit
@Service
public class OrderService {
    @Autowired
    private KafkaTemplate<String, String> kafkaTemplate;

    public void createOrder(Order order) {
        // Save order in DB
        // Send event to payment service
        kafkaTemplate.send("payment-topic", new ObjectMapper().writeValueAsString(order));
    }
}
🧱 2. Payment Service (Listener & Publisher)
java
Copy
Edit
@Component
public class PaymentConsumer {

    @KafkaListener(topics = "payment-topic", groupId = "saga")
    public void handlePayment(String message) throws JsonProcessingException {
        Order order = new ObjectMapper().readValue(message, Order.class);

        // Simulate payment success
        boolean paymentSuccess = true;

        if (paymentSuccess) {
            kafkaTemplate.send("inventory-topic", message); // Forward to Inventory
        } else {
            kafkaTemplate.send("order-topic", "PAYMENT_FAILED for order: " + order.getId());
        }
    }
}
🧱 3. Inventory Service
java
Copy
Edit
@Component
public class InventoryConsumer {

    @KafkaListener(topics = "inventory-topic", groupId = "saga")
    public void handleInventory(String message) throws JsonProcessingException {
        Order order = new ObjectMapper().readValue(message, Order.class);

        // Check inventory
        boolean inStock = true;

        if (inStock) {
            System.out.println("Inventory reserved for Order ID: " + order.getId());
            kafkaTemplate.send("order-topic", "ORDER_COMPLETED for order: " + order.getId());
        } else {
            kafkaTemplate.send("order-topic", "INVENTORY_FAILED for order: " + order.getId());
        }
    }
}
🔄 Compensation Logic in Order Service (If Any Step Fails)
