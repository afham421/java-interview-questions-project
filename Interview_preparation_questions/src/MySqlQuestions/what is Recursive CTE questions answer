1️⃣ COUNT UP UNTIL THREE
WITH RECURSIVE counter AS (
    SELECT 1 AS num          -- Anchor
    
    UNION ALL
    
    SELECT num + 1           -- Recursive
    FROM counter
    WHERE num < 3
)
SELECT * FROM counter;
✅ Output:
1
2
3
2️⃣ Finding Bosses and Hierarchical Level for All Employees
👇 Table Example
id	name	manager_id
1	CEO	NULL
2	Ali	1
3	Ahmed	2
4	Sara	2
✅ Query with Level
WITH RECURSIVE emp_tree AS (
    -- Anchor (Top boss)
    SELECT id, name, manager_id, 1 AS level
    FROM employees
    WHERE manager_id IS NULL
    
    UNION ALL
    
    -- Recursive
    SELECT e.id, e.name, e.manager_id, et.level + 1
    FROM employees e
    JOIN emp_tree et ON e.manager_id = et.id
)
SELECT * FROM emp_tree;
🔎 Output:
id	name	level
1	CEO	1
2	Ali	2
3	Ahmed	3
4	Sara	3
3️⃣ Finding Routes Between Cities
👇 Table Example
from_city	to_city
A	B
B	C
C	D
✅ Query
WITH RECURSIVE routes AS (
    -- Anchor
    SELECT from_city, to_city, 
           CONCAT(from_city, ' -> ', to_city) AS path
    FROM city_routes
    
    UNION ALL
    
    -- Recursive
    SELECT r.from_city, c.to_city,
           CONCAT(r.path, ' -> ', c.to_city)
    FROM routes r
    JOIN city_routes c ON r.to_city = c.from_city
)
SELECT * FROM routes;
🔎 Output:
A -> B
A -> B -> C
A -> B -> C -> D

Used for:

Flight connections

Road maps

Network traversal

4️⃣ FINDING ANCESTORS (Parent Chain)
👇 Table Example
id	name	parent_id
1	Grand	NULL
2	Father	1
3	Son	2
✅ Query (Find ancestors of Son)
WITH RECURSIVE ancestors AS (
    -- Start from Son
    SELECT id, name, parent_id
    FROM family
    WHERE name = 'Son'
    
    UNION ALL
    
    -- Recursive
    SELECT f.id, f.name, f.parent_id
    FROM family f
    JOIN ancestors a ON f.id = a.parent_id
)
SELECT * FROM ancestors;
🔎 Output:
Son
Father
Grand
🎯 Interview Short Explanation

Recursive CTE is used when data is hierarchical or sequential.
It has an anchor query and a recursive query.
It keeps running until the stopping condition is met.