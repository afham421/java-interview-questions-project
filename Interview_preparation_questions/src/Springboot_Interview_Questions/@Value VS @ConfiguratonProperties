✅ Injecting a List from application.yml
📁 application.yml
yaml
Copy
Edit
myapp:
  supported-languages:
    - Java
    - Python
    - Go
📦 Java Class
java
Copy
Edit
import org.springframework.boot.context.properties.ConfigurationProperties;
import org.springframework.stereotype.Component;
import java.util.List;

@Component
@ConfigurationProperties(prefix = "myapp")
public class MyAppConfig {

    private List<String> supportedLanguages;

    public List<String> getSupportedLanguages() {
        return supportedLanguages;
    }

    public void setSupportedLanguages(List<String> supportedLanguages) {
        this.supportedLanguages = supportedLanguages;
    }
}
✅ Usage
java
Copy
Edit
@Autowired
private MyAppConfig config;

public void showLanguages() {
    config.getSupportedLanguages().forEach(System.out::println);
}
✅ Injecting a Map from application.yml
📁 application.yml
yaml
Copy
Edit
myapp:
  error-messages:
    404: "Not Found"
    500: "Server Error"
    403: "Forbidden"
📦 Java Class
java
Copy
Edit
import org.springframework.boot.context.properties.ConfigurationProperties;
import org.springframework.stereotype.Component;
import java.util.Map;

@Component
@ConfigurationProperties(prefix = "myapp")
public class MyAppConfig {

    private Map<String, String> errorMessages;

    public Map<String, String> getErrorMessages() {
        return errorMessages;
    }

    public void setErrorMessages(Map<String, String> errorMessages) {
        this.errorMessages = errorMessages;
    }
}
✅ Usage
java
Copy
Edit
@Autowired
private MyAppConfig config;

public void showErrors() {
    config.getErrorMessages().forEach((code, msg) ->
        System.out.println(code + " => " + msg));
}

🎯 Summary
| Type | YAML Format  | Java Type             |
| ---- | ------------ | --------------------- |
| List | `- item`     | `List<String>`        |
| Map  | `key: value` | `Map<String, String>` |
